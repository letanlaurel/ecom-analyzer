# AI 分析（二选一，优先使用 Gemini）
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# eBay Browse API（可选，留空则降级为无头浏览器抓取）
# 申请地址: https://developer.ebay.com/
EBAY_APP_ID=YourApp-xxxx-PRD-xxxxxxxxxxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Etsy Open API v3（可选，留空则降级为无头浏览器抓取）
# 申请地址: https://www.etsy.com/developers/register
ETSY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 淘宝开放平台（淘宝客 API，必填才能抓取淘宝）
# 申请地址: https://open.taobao.com/ → 创建应用 → 申请 taobao.tbk.dg.item.get 权限
TAOBAO_APP_KEY=your_app_key
TAOBAO_APP_SECRET=your_app_secret
TAOBAO_SESSION_KEY=your_session_key  # 可选，淘宝客授权 session

# 京东联盟开放平台（必填才能抓取京东）
# 申请地址: https://union.jd.com/ → 工具 → API → 申请开通
JD_APP_KEY=your_app_key
JD_APP_SECRET=your_app_secret

# 拼多多多多客开放平台（必填才能抓取拼多多）
# 申请地址: https://open.pinduoduo.com/ → 创建应用 → 申请 pdd.ddk.goods.search 权限
PDD_CLIENT_ID=your_client_id
PDD_CLIENT_SECRET=your_client_secret

# TikTok 趋势监控（可选）
# 监控的标签列表，逗号分隔
TIKTOK_HASHTAGS=#PetHealth,#DogAnxiety
# 并发爬虫数量（建议 2~3，过高易触发反爬）
TIKTOK_WORKERS=2
# GrowthScore 最低阈值（0 = 不过滤，推荐 0.03~0.1）
TIKTOK_MIN_SCORE=0.03

# 代理（可选，格式: http://user:pass@host:port）
# HTTP_PROXY=http://127.0.0.1:7890
